#!/usr/bin/env node
// gh for hosted Desk. A Desk child's PATH finds this shim first. For each
// call it asks the gateway's token socket for a fresh installation token,
// so a long session never holds an expired one, and runs the real gh with
// GH_TOKEN set for that call only. The real gh is DESK_REAL_GH, or the next
// gh on PATH after this shim's own directory.
import { spawn } from "node:child_process";
import { accessSync, constants, realpathSync } from "node:fs";
import { delimiter, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { requestToken } from "../src/token-client.js";

const fail = (message, code = 1) => {
  process.stderr.write(`gh (hosted Desk): ${message}\n`);
  process.exit(code);
};

const realDir = (dir) => {
  try {
    return realpathSync(dir);
  } catch {
    return dir;
  }
};

function findRealGh() {
  if (process.env.DESK_REAL_GH) return process.env.DESK_REAL_GH;
  const ownDir = realDir(dirname(fileURLToPath(import.meta.url)));
  for (const dir of (process.env.PATH ?? "").split(delimiter)) {
    if (!dir || realDir(dir) === ownDir) continue;
    const candidate = join(dir, "gh");
    try {
      accessSync(candidate, constants.X_OK);
      return candidate;
    } catch {}
  }
  return null;
}

const realGh = findRealGh();
if (!realGh) fail("the real gh is not installed (set DESK_REAL_GH or put gh on PATH).", 127);
let token;
try {
  token = await requestToken();
} catch (error) {
  fail(error.message);
}
const child = spawn(realGh, process.argv.slice(2), { stdio: "inherit", env: { ...process.env, GH_TOKEN: token } });
for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, () => child.kill(signal));
child.on("error", (error) => fail(`could not run ${realGh}: ${error.message}`));
child.on("close", (code, signal) => {
  if (signal) {
    process.removeAllListeners(signal);
    process.kill(process.pid, signal);
  }
  else process.exit(code ?? 1);
});
