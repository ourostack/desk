{
  "name": "@ourostack/desk-mcp",
  "version": "1.4.0-alpha.6",
  "private": true,
  "type": "module",
  "description": "MCP server for the desk plugin — task/track/friction/lesson CRUD + hybrid lexical+semantic search over the desk workspace. Spawned by the consumer (Claude Code, Copilot CLI, ouroboros daemon) pointed at a desk root via --root.",
  "bin": {
    "desk-mcp": "./index.js"
  },
  "main": "./index.js",
  "scripts": {
    "test": "node --import ../../../tests/desk/mcp/__tests__/_isolated_env.mjs --test \"../../../tests/desk/mcp/__tests__/**/*.test.js\"",
    "test:coverage": "node ../../../tools/desk-build/scripts/run-coverage.js",
    "activation:support-matrix:generate": "node ../../../tools/desk-build/scripts/generate-support-matrix.js",
    "activation:copilot-bundle:generate": "node ../../../tools/desk-build/scripts/generate-copilot-bundle.js",
    "runtime:deps-pack:build": "node scripts/build-runtime-deps-pack.js",
    "runtime:deps-pack:verify": "node scripts/verify-runtime-deps-pack.js",
    "runtime:support-matrix:generate": "node ../../../tools/desk-build/scripts/generate-runtime-support-matrix.js",
    "runtime:support-matrix:verify": "node ../../../tools/desk-build/scripts/verify-runtime-support-matrix.js"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "1.11.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.3.0",
    "gray-matter": "^4.0.3",
    "sqlite-vec": "^0.1.6",
    "unicode-case-folding": "1.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@istanbuljs/esm-loader-hook": "0.3.0",
    "@unicode/unicode-16.0.0": "2.0.2",
    "nyc": "18.0.0"
  },
  "overrides": {
    "test-exclude": "8.0.0"
  }
}
