{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.cjs\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/factory-end.cjs\" claude",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v node >/dev/null 2>&1; then node \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-session-start.cjs\" \"${CLAUDE_PLUGIN_ROOT}/skills/using-desk/SKILL.md\"; else desk_host=claude; . \"${CLAUDE_PLUGIN_ROOT}/hooks/node-missing.sh\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
