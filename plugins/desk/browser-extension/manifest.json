{
  "manifest_version": 3,
  "name": "Desk Browser Ownership",
  "version": "1.0.0",
  "minimum_chrome_version": "125",
  "description": "Recognizable agent-owned background browser windows for Desk.",
  "key": "",
  "permissions": ["nativeMessaging", "debugger", "tabs", "offscreen"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
