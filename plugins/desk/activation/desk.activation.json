{
  "schema_version": 1,
  "id": "desk",
  "version": "3.2.42",
  "dependencies": [
    {
      "id": "desk",
      "kind": "substrate",
      "version": "3.2.42",
      "provenance": {
        "source": "plugins/desk/.claude-plugin/plugin.json",
        "package": "ourostack/desk"
      },
      "lock": {
        "version": "3.2.42",
        "integrity": "sha256-desk-activation-manifest-v1"
      }
    },
    {
      "id": "superpowers",
      "kind": "plugin",
      "version_range": "^6.3.0",
      "provenance": {
        "source": "plugins/superpowers/.claude-plugin/plugin.json",
        "package": "obra/superpowers"
      },
      "lock": {
        "version": "6.4.4",
        "integrity": "sha256-a6ce3a2accf90ec523f7f35be2a76142b94b7178dcbf688d10b756a45f1a2fd0"
      }
    },
    {
      "id": "plain-language",
      "kind": "plugin",
      "version_range": "^0.2.6",
      "provenance": {
        "source": "plugins/plain-language/.claude-plugin/plugin.json",
        "package": "ourostack/plain-language"
      },
      "lock": {
        "version": "0.2.8",
        "integrity": "sha256-plain-language-activation-manifest-v1"
      }
    }
  ],
  "provides": {
    "activation_targets": [
      {
        "id": "desk:worker",
        "kind": "agent",
        "default": true,
        "depends_on": [
          "desk",
          "superpowers",
          "plain-language"
        ],
        "entrypoints": {
          "claude": "agents/worker.md",
          "copilot": "agents/worker.agent.md"
        },
        "startup": {
          "foundation": "skills/using-desk/SKILL.md",
          "authoritative_scan": "skills/session-start/SKILL.md"
        }
      },
      {
        "id": "desk:observer",
        "kind": "agent",
        "default": false,
        "depends_on": [
          "desk",
          "superpowers",
          "plain-language"
        ],
        "entrypoints": {
          "claude": "agents/observer.md",
          "copilot": "agents/observer.agent.md"
        },
        "startup": {
          "foundation": "skills/using-desk/SKILL.md"
        }
      }
    ],
    "overlay_agents": []
  },
  "mcp_servers": [
    {
      "id": "desk",
      "required": true,
      "command": "node",
      "args": [
        "mcp/index.js"
      ],
      "launch": "host-native"
    }
  ],
  "desk_root": {
    "policy": "global-default",
    "precedence": [
      "activation",
      "DESK",
      "safe-default"
    ],
    "opt_out_modes": [
      "project-local",
      "manual-only"
    ]
  },
  "desk_runtime": {
    "root": "workspace",
    "write_authority": "workspace",
    "lexical": "required",
    "semantic": "background"
  },
  "host_support": [
    {
      "host": "claude",
      "status": "supported",
      "dependency_resolution": "native-or-flattened",
      "fallback_behavior": "launch foreground with `claude --agent desk:worker`; ship flattened bundle when transitive dependencies are unavailable",
      "capabilities": [
        "skills",
        "mcp",
        "agents",
        "hooks"
      ],
      "unsupported_primitives": [
        "agent-view-dispatch",
        "background-session-inheritance"
      ]
    },
    {
      "host": "ouroboros-autonomous-agent",
      "status": "supported",
      "dependency_resolution": "flattened",
      "fallback_behavior": "bundle Desk + Superpowers + Plain Language into the agent bundle and bind $DESK to ~/AgentBundles/<agent>.ouro/desk/; alpha source packaging is not native runtime qualification",
      "capabilities": [
        "agents",
        "skills",
        "mcp"
      ],
      "unsupported_primitives": [
        "host-native-plugin-install"
      ]
    },
    {
      "host": "generic-stdio",
      "status": "degraded",
      "dependency_resolution": "manual-host",
      "fallback_behavior": "start MCP with explicit --root or DESK and no worker activation",
      "capabilities": [
        "mcp"
      ],
      "unsupported_primitives": [
        "agent-defaults",
        "plugin-dependency-resolution"
      ]
    }
  ],
  "host_activation": {
    "claude": {
      "defaultMode": "plugin-agent",
      "targets": {
        "desk:worker": {
          "default": true,
          "source": "agents/worker.md",
          "activationSurface": "plugin-agent"
        },
        "desk:observer": {
          "default": false,
          "source": "agents/observer.md",
          "activationSurface": "plugin-agent"
        }
      },
      "nativeSurfaces": [
        "skills",
        "agents",
        "hooks",
        "mcpServers",
        "dependencies"
      ],
      "mcpServers": {
        "desk": {
          "launch": "plugin-bundled",
          "manualRegistration": false,
          "configPath": ".mcp.claude-codex.json"
        }
      },
      "dependencies": {
        "superpowers": {
          "path": "../superpowers",
          "version": "6.4.4",
          "resolution": "native"
        },
        "plain-language": {
          "path": "../plain-language",
          "version": "0.2.8",
          "resolution": "native"
        }
      },
      "agentView": {
        "status": "degraded",
        "minimumClaudeCodeVersion": "2.1.139",
        "foregroundLaunch": "claude --agent desk:worker",
        "agentViewLaunch": "claude agents --agent desk:worker",
        "inheritsPluginContext": false,
        "evidence": "Claude Code 2.1.161 help exposes `claude agents --agent` and `--plugin-dir`, but Unit 4b did not capture a dispatched-session smoke proving `desk:worker` loads with Desk plugin context.",
        "reason": "Historical help text proves flags exist, not that Agent View sessions inherit the selected Desk agent, MCP, hooks and Superpowers provider. Alpha inheritance remains unqualified.",
        "fallback": "Launch foreground with `claude --agent desk:worker`; for Agent View experiments, pass explicit `--plugin-dir` and `--mcp-config` until a dispatched-session smoke proves inheritance."
      },
      "backgroundSessionInheritance": {
        "status": "unsupported",
        "minimumClaudeCodeVersion": "2.1.139",
        "agentViewLaunch": "claude agents --agent desk:worker",
        "inheritsPluginContext": false,
        "evidence": "Claude Code 2.1.161 `claude agents --help` exposes background-agent flags, but no Unit 4b dispatched-session smoke validates plugin-context inheritance; the worker agent frontmatter also declares `background: false`.",
        "reason": "Background inheritance is not proven by historical help text. It remains unsupported until a real background session loads `desk:worker` with the selected Desk MCP and Superpowers skills.",
        "fallback": "Launch foreground with `claude --agent desk:worker` when plugin-context inheritance is required."
      },
      "permissionBoundary": {
        "requestedCapabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "generatedArtifacts": [],
        "neverDelete": [
          "desk-root-data"
        ],
        "unsupportedAgentScopedFields": [
          "hooks",
          "mcpServers",
          "permissionMode"
        ]
      }
    }
  },
  "permissions": {
    "requested_capabilities": [
      "Read",
      "Write",
      "Interactive"
    ],
    "generated_artifacts": [
      "owned-host-config"
    ],
    "never_delete": [
      "desk-root-data"
    ]
  }
}
