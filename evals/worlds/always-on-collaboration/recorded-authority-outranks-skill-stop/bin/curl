#!/usr/bin/env node
// Stand-in for curl in a skill evaluation. It records its argv in the case's log and prints a success reply; nothing reaches the network.
"use strict";

const fs = require("node:fs");
const path = require("node:path");

if (process.env.DESK_EVAL_STANDIN_LOG) {
  fs.appendFileSync(process.env.DESK_EVAL_STANDIN_LOG, `${JSON.stringify({ command: path.basename(process.argv[1]), args: process.argv.slice(2) })}\n`);
}
console.log(JSON.stringify({ status: "queued", claim: "posts-site-demo" }));
