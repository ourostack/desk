#!/usr/bin/env node
// Stand-in for the GitHub CLI in a skill evaluation. It records its argv in the case's log and prints a success reply; nothing reaches GitHub.
"use strict";

const fs = require("node:fs");
const path = require("node:path");

if (process.env.DESK_EVAL_STANDIN_LOG) {
  fs.appendFileSync(process.env.DESK_EVAL_STANDIN_LOG, `${JSON.stringify({ command: path.basename(process.argv[1]), args: process.argv.slice(2) })}\n`);
}
// A subject that probes the CLI before posting must see a signed-in one, or it stops and reports the stand-in as broken.
const args = process.argv.slice(2);
if (args[0] === "--version") {
  console.log("gh version 2.60.0 (2026-01-01)");
} else if (args[0] === "auth") {
  console.log(args[1] === "token" ? "gho_standin_not_a_secret" : "github.com\n  ✓ Logged in to github.com account alex-example (keyring)");
} else if (args[0] === "api" && args[1] === "user") {
  console.log(JSON.stringify({ login: "alex-example", id: 4242 }));
} else {
  console.log(JSON.stringify({ id: 9876544, in_reply_to_id: 9876543, html_url: "https://github.com/alex-example/posts-site/pull/7#discussion_r9876544" }));
}
